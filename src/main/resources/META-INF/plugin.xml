<idea-plugin>
    <id>dev.marginalis.plugin</id>
    <name>Marginalis</name>
    <vendor email="muhammadfarag@gmail.com" url="https://github.com/MuhammadFarag/marginalis">Muhammad Farag</vendor>
    <description><![CDATA[
        In-editor margin notes shared between a human and an agent.
        Comments anchor to lines, thread, and resolve — Google Docs comments over live code.
    ]]></description>

    <depends>com.intellij.modules.platform</depends>

    <actions>
        <action id="marginalis.addComment"
                class="dev.marginalis.plugin.actions.AddCommentAction"
                text="Add Marginalis Comment"
                description="Start a margin thread on the current line for the agent to pick up">
            <add-to-group group-id="EditorPopupMenu" anchor="last"/>
            <keyboard-shortcut keymap="$default" first-keystroke="ctrl alt M"/>
        </action>
    </actions>

    <extensions defaultExtensionNs="com.intellij">
        <!-- Transport: Option B (built-in HTTP server, handover §6). -->
        <httpRequestHandler implementation="dev.marginalis.plugin.transport.MarginalisRestService"/>
        <!-- Keeps gutter icons in sync with thread status/unread changes. -->
        <postStartupActivity implementation="dev.marginalis.plugin.MarginalisStartup"/>
        <!-- Cross-file visibility: all threads grouped by file (handover §8). -->
        <toolWindow id="Marginalis" anchor="right"
                    icon="AllIcons.Toolwindows.ToolWindowMessages"
                    factoryClass="dev.marginalis.plugin.ui.toolwindow.MarginalisToolWindowFactory"/>
        <!-- At-a-glance: tab-title glyph for files with open threads. -->
        <editorTabTitleProvider implementation="dev.marginalis.plugin.ui.MarginalisTabTitleProvider"/>
    </extensions>
</idea-plugin>
