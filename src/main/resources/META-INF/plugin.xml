<idea-plugin>
    <id>dev.marginalis.plugin</id>
    <name>Marginalis</name>
    <vendor email="m@far.ag" url="https://github.com/MuhammadFarag/marginalis">Muhammad Farag</vendor>
    <description><![CDATA[
        In-editor margin notes shared between you and your coding agent.
        Comments anchor to lines, thread, and resolve — Google Docs comments over live code.
    ]]></description>

    <depends>com.intellij.modules.platform</depends>

    <actions>
        <action id="marginalis.addComment"
                class="dev.marginalis.plugin.actions.AddCommentAction"
                text="Add Marginalis Comment"
                icon="AllIcons.General.Balloon"
                description="Start a margin thread on the current line for the agent to pick up">
            <add-to-group group-id="EditorPopupMenu" anchor="last"/>
            <keyboard-shortcut keymap="$default" first-keystroke="ctrl alt M"/>
        </action>
    </actions>

    <applicationListeners>
        <!-- Clean unload: strip our classes from platform structures that
             outlive the classloader, so plugin updates hot-reload without
             an IDE restart. -->
        <listener class="dev.marginalis.plugin.MarginalisUnloadListener"
                  topic="com.intellij.ide.plugins.DynamicPluginListener"/>
    </applicationListeners>

    <extensions defaultExtensionNs="com.intellij">
        <!-- Agent transport: JSON endpoints on the IDE's built-in HTTP server. -->
        <httpRequestHandler implementation="dev.marginalis.plugin.transport.MarginalisRestService"/>
        <!-- Keeps gutter icons in sync with thread status/unread changes. -->
        <postStartupActivity implementation="dev.marginalis.plugin.MarginalisStartup"/>
        <!-- Cross-file visibility: all threads, grouped by file. -->
        <!-- Left: this is a navigation surface, and navigation lives on the left. -->
        <toolWindow id="Marginalis" anchor="left"
                    icon="AllIcons.Toolwindows.ToolWindowMessages"
                    factoryClass="dev.marginalis.plugin.ui.toolwindow.MarginalisToolWindowFactory"/>
        <!-- At-a-glance: tab-title glyph for files with open threads. -->
        <editorTabTitleProvider implementation="dev.marginalis.plugin.ui.MarginalisTabTitleProvider"/>
        <!-- Navigation consent + display name; app-level, these follow the user. -->
        <applicationConfigurable parentId="tools" id="dev.marginalis.settings"
                                 displayName="Marginalis"
                                 instance="dev.marginalis.plugin.settings.MarginalisConfigurable"/>
    </extensions>
</idea-plugin>
